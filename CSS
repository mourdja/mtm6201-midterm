/* I keep the colors and fonts here so I can reuse them  */
:root {
  --white: #ffffff;
  --black: #000000;
  --gold: #d69e3d;
  --brown: #966f2c;
  --paper: #f3f0e9;
  --heading-font: Lato, sans-serif;
  --body-font: Karla, sans-serif;
  --space: clamp(4rem, 7vw, 8rem);
}


/* Padding and borders count toward the width of each box */
* {
  box-sizing: border-box;
}



/* I use Karla for regular text and Lato for headings and navigation */
body {
  margin: 0;
  background: var(--paper);
  color: var(--black);
  font: 1rem/1.3 var(--body-font);
}

img {
  display: block;
  max-width: 100%;
}



h1, h2, h3, p, figure, blockquote {
  margin: 0;
}


h1, h2, h3, nav {
  font-family: var(--heading-font);
  text-transform: uppercase;
}

h1, h2, h3 {
  line-height: 1.1;
}

h1 { font-size: 2.027rem; font-weight: 900; }
h2 { font-size: 1.802rem; }
h3 { font-size: 1.424rem; }

/* The wrapper keeps the same side spacing and stops growing at 1200px */
.wrapper {
  width: calc(100% - 2rem);
  max-width: 1200px;
  margin-inline: auto;
}

/* The skip link shows up when someone tabs to it */
.skip-link {
  position: absolute;
  z-index: 1;
  top: .5rem;
  left: .5rem;
  padding: .75rem 1rem;
  transform: translateY(-150%);
  background: var(--white);
  color: var(--black);
}

.skip-link:focus {
  transform: translateY(0);
}


/* The outline makes it easier to see which link is selected with the keyboard */
a:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 2px;
  box-shadow: 0 0 0 6px var(--brown);
}

.site-header, .site-footer, .testimonials {
  background: var(--black);
  color: var(--white);
}

/* On phones the logo sits above the menu. The links can wrap if needed */
.header-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding-block: 1rem;
}

.logo {
  width: 13.75rem;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: .5rem clamp(.5rem, 2.3vw, 2.5rem);
  margin: 0;
  padding: 0;
  list-style: none;
}

nav a {
  display: block;
  padding: .5rem;
  color: var(--white);
  font-weight: 900;
  text-decoration: none;
}

nav a:hover, nav a:focus-visible {
  color: var(--gold);
}