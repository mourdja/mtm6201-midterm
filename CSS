/* I keep the colors and fonts here so I can reuse them  */
:root {
  --white: #ffffff;
  --black: #000000;
  --gold: #d69e3d;
  --brown: #966f2c;
  --paper: #f3f0e9;
  --heading-font: Lato, sans-serif;
  --body-font: Karla, sans-serif;
  --space: clamp(4rem, 7vw, 8rem);
}


/* Padding and borders count toward the width of each box */
* {
  box-sizing: border-box;
}



/* I use Karla for regular text and Lato for headings and navigation */
body {
  margin: 0;
  background: var(--paper);
  color: var(--black);
  font: 1rem/1.3 var(--body-font);
}

img {
  display: block;
  max-width: 100%;
}



h1, h2, h3, p, figure, blockquote {
  margin: 0;
}


h1, h2, h3, nav {
  font-family: var(--heading-font);
  text-transform: uppercase;
}

h1, h2, h3 {
  line-height: 1.1;
}

h1 { font-size: 2.027rem; font-weight: 900; }
h2 { font-size: 1.802rem; }
h3 { font-size: 1.424rem; }

/* The wrapper keeps the same side spacing and stops growing at 1200px */
.wrapper {
  width: calc(100% - 2rem);
  max-width: 1200px;
  margin-inline: auto;
}

/* The skip link shows up when someone tabs to it */
.skip-link {
  position: absolute;
  z-index: 1;
  top: .5rem;
  left: .5rem;
  padding: .75rem 1rem;
  transform: translateY(-150%);
  background: var(--white);
  color: var(--black);
}

.skip-link:focus {
  transform: translateY(0);
}


/* The outline makes it easier to see which link is selected with the keyboard */
a:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: 2px;
  box-shadow: 0 0 0 6px var(--brown);
}

.site-header, .site-footer, .testimonials {
  background: var(--black);
  color: var(--white);
}

/* On phones the logo sits above the menu. The links can wrap if needed */
.header-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding-block: 1rem;
}

.logo {
  width: 13.75rem;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: .5rem clamp(.5rem, 2.3vw, 2.5rem);
  margin: 0;
  padding: 0;
  list-style: none;
}

nav a {
  display: block;
  padding: .5rem;
  color: var(--white);
  font-weight: 900;
  text-decoration: none;
}

nav a:hover, nav a:focus-visible {
  color: var(--gold);
}
/* Both sections have centered text over a photo that fills the space. */
.hero, .promotions {
  background-color: var(--black);
  background-position: center;
  background-size: cover;
  color: var(--white);
  text-align: center;
}

/* I darken the banner photo so the white text is easier to read. */
.hero {
  display: grid;
  align-items: center;
  min-height: 30rem;
  padding-block: 4rem;
  background-image: linear-gradient(rgba(0, 0, 0, .65), rgba(0, 0, 0, .65)), url("../images/hero-background.jpg");
}

.hero h1, .hero p {
  max-width: 39rem;
  margin-inline: auto;
}

.hero p, .about p + p {
  margin-top: .75rem;
}

/* The small label above each heading matches the mockup. */
.eyebrow {
  margin-bottom: .6rem;
  color: var(--brown);
  text-transform: uppercase;
}

.promotions .eyebrow, .testimonials .eyebrow {
  color: var(--gold);
}

/* The buttons share the same padding and text style  Each type has its own colors */
.button {
  display: inline-block;
  margin-top: clamp(1.5rem, 3vw, 3rem);
  padding: .75rem clamp(1.25rem, 2.5vw, 2.5rem);
  border: 2px solid transparent;
  color: var(--white);
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  text-transform: uppercase;
  transition: color .2s ease, background-color .2s ease, border-color .2s ease;
}

.button-light {
  background: var(--white);
  color: var(--black);
}

.button-dark { background: var(--black); }
.button-outline { border-color: var(--white); }

/* Buttons turn gold on hover or keyboard focus  and brown when pressed */
.button:hover, .button:focus-visible {
  border-color: var(--gold);
  background: var(--gold);
  color: var(--black);
}

.button:active {
  border-color: var(--brown);
  background: var(--brown);
  color: var(--black);
}
.gallery-section, .offers, .about, .testimonials {
  padding-top: var(--space);
}

.gallery-section h2, .testimonials h2 {
  max-width: 38rem;
}

.gallery, .offer-grid, .promotion-grid, .about, .testimonial-grid {
  display: grid;
  gap: 1.25rem;
}

/* On phones, the gallery has two columns the first photo fills the top row */
.gallery {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: clamp(1rem, 1.8vw, 2rem);
  gap: clamp(.75rem, 1.2vw, 1.25rem);
}

/* I crop the photos into squares so they line up and keep their shape */
.gallery img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
}
.gallery-feature { grid-column: span 2; }

.offers {
  padding-bottom: var(--space);
  text-align: center;
}

/* The offers stack on phones i use the same size for all three icons */
.offer-grid {
  margin-top: 2.5rem;
  gap: 2.75rem;
}

.offer-grid article { max-width: 23rem; margin-inline: auto; }

/*give all three icons the same square space and keep each one fully visible*/

.offer-grid img {
  width: clamp(6.5rem, 10vw, 10rem);
  height: clamp(6.5rem, 10vw, 10rem);
  margin: 0 auto 1rem;
  object-fit: contain;
}

.offer-grid p, .about h2 + p {
  margin-top: .5rem;
}

/* I darken the shop photo so the text over it is easier to read */
.promotions {
  padding-block: var(--space);
  background-image: linear-gradient(rgba(0, 0, 0, .65), rgba(0, 0, 0, .65)), url("../images/coffee-shop.jpeg");
}

.promotion-grid {
  gap: 3rem;
}

.promotion-grid h2 {
  max-width: 33rem;
  margin-inline: auto;
}

.about {
  padding-bottom: var(--space);
}

/* The story photo has a tall crop like the one in the mockup */
.about img {
  width: 100%;
  aspect-ratio: 5 / 6;
  object-fit: cover;
}